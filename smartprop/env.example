# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# pg-boss Configuration
# pg-boss will automatically use Supabase if you set SUPABASE_DB_PASSWORD
# It will construct the connection string from NEXT_PUBLIC_SUPABASE_URL
#
# Option 1 (Recommended): Auto-construct from Supabase URL
# SUPABASE_DB_PASSWORD=your-database-password
# (pg-boss will use: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres)
#
# Option 2: Manual connection string
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Option 3: Dedicated connection for pg-boss
# PG_BOSS_DATABASE_URL=postgresql://postgres:[password]@[host]:[port]/postgres
#
# Get your database password from: Supabase Dashboard → Settings → Database → Database password
PG_BOSS_SCHEMA=jobqueue
PG_BOSS_POOL_MAX=5
PG_BOSS_POLL_INTERVAL=5
PG_BOSS_MONITOR_INTERVAL=60
PG_FORCE_IPV4=true
PG_SSL_REJECT_UNAUTHORIZED=true
# PG_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
SCRAPER_HEARTBEAT_MS=30000
SCRAPER_KEEP_UNTIL=86400

# Application Configuration
PUBLIC_BASE_URL=http://your-server-ip-or-domain
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=replace-with-a-strong-random-password

# WAHA (WhatsApp HTTP API) Configuration
# Note: WAHA runs on port 3030 (docker-compose maps 3030:3000)
WAHA_URL=http://localhost:3030
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-strong-random-password

# Scraper Configuration (Optional)
HEADLESS=true
# Note: PG_MAX_PAGES and EP_MAX_PAGES are controlled by the frontend UI
# They are no longer needed in .env.local as they are set per-job via the queue system
PG_EMAIL=your_pg_email@example.com
PG_PASSWORD=your_pg_password
EP_EMAIL=your_ep_email@example.com
EP_PASSWORD=your_ep_password
# EdgeProp scrapes ALL districts with price range $0-$3M
# Deduplication is automatic via database unique constraints

# Groq AI (for parsing viewing timeslots) - Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Buyer Agent Profile (You are the buyer's agent, not the buyer)
BUYER_AGENT_NAME=Jeremy
BUYER_AGENT_CEA_REG=R012345A
BUYER_AGENT_AVAILABILITY=Monday to Friday 8pm to 10pm

# Human-Like Typing Behavior (Makes AI feel more natural)
# Set to 'true' to enable typing indicators and realistic delays
# Set to 'false' for instant replies (testing/debugging)
ENABLE_TYPING_SIMULATION=true

# LinkedIn Automation Configuration
# NopeCHA CAPTCHA Solver - Works FREE without API key (100 CAPTCHAs/day)
# Optional: Set NOPECHA_API_KEY for higher limits (get key at https://nopecha.com)
# NOPECHA_API_KEY=your_nopecha_api_key_here
# Credentials are stored server-side only for security
# Settings are configured in the admin dashboard UI
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
# Set to true only when you explicitly want to retry contacts whose last run failed
# LINKEDIN_RETRY_FAILED=false
# Note: Profile URL and company URL are configured in the admin dashboard
# Storage path for LinkedIn session state
# LINKEDIN_STORAGE_PATH=storage/linkedin.state.json
