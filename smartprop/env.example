# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Application Configuration
PUBLIC_BASE_URL=http://52.76.114.103

# WAHA (WhatsApp HTTP API) Configuration
# Note: WAHA runs on port 3030 (docker-compose maps 3030:3000)
WAHA_URL=http://localhost:3030
WAHA_SESSION=default

# Scraper Configuration (Optional)
HEADLESS=true
PG_MAX_PAGES=3
PG_EMAIL=your_pg_email@example.com
PG_PASSWORD=your_pg_password
EP_EMAIL=your_ep_email@example.com
EP_PASSWORD=your_ep_password
EP_MAX_PAGES=3
# EdgeProp scrapes ALL districts with price range $0-$3M
# Deduplication is automatic via database unique constraints

# Groq AI (for parsing viewing timeslots) - Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Buyer Agent Profile (You are the buyer's agent, not the buyer)
BUYER_AGENT_NAME=Jeremy
BUYER_AGENT_CEA_REG=R012345A
BUYER_AGENT_AVAILABILITY=Monday to Friday 8pm to 10pm

# Human-Like Typing Behavior (Makes AI feel more natural)
# Set to 'true' to enable typing indicators and realistic delays
# Set to 'false' for instant replies (testing/debugging)
ENABLE_TYPING_SIMULATION=true
