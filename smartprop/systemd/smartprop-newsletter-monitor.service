[Unit]
Description=Verify SmartProp WhatsApp newsletter and check in externally
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/smartprop/newsletter-monitor.env
Environment=SMARTPROP_NEWSLETTER_BUN_BIN=/run/smartprop-newsletter-monitor/bun
RuntimeDirectory=smartprop-newsletter-monitor
BindReadOnlyPaths=/root/.bun/bin/bun:/run/smartprop-newsletter-monitor/bun
ExecStart=/opt/smartprop/app/smartprop/scripts/monitor-newsletter-campaign.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=128M
TasksMax=64
TimeoutStartSec=180
UMask=0077
