[Unit]
Description=Check SmartProp newsletter workflow at fixed SGT checkpoints

[Timer]
OnCalendar=*-*-* 01:22:00 UTC
OnCalendar=*-*-* 01:37:00 UTC
OnCalendar=*-*-* 01:52:00 UTC
OnCalendar=*-*-* 02:07:00 UTC
OnCalendar=*-*-* 02:22:00 UTC
Persistent=true
RandomizedDelaySec=0
Unit=smartprop-newsletter-monitor.service

[Install]
WantedBy=timers.target
